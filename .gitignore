# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
# *.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — every layer the server reads, since a PORTAL_* variable in
# any of them carries a database URL, a session secret or a payment secret. The
# tracked reference is named env.example, without the leading dot, so that this
# one pattern needs no exception.
.env*

# configuration files — hold db/auth/payment secrets, never commit; only the
# generated references (portal.config.example.json, portal.config.schema.json)
# are tracked. portal.env is what `config:migrate --format env` writes.
/portal.config*.json
!/portal.config.example.json
!/portal.config.schema.json
/portal.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# goovee
goovee/.generated

portal/

# Serwist
public/sw*

# copied from the installed pdf reader by scripts/copy-pdfjs-assets.mjs
public/pdfjs

# generated css for templates
app/\[tenant]/\[workspace]/\(subapps)/website/common/assets/css

.prettier-cache
