# Portal configuration.
#
# Every setting is one environment variable starting with PORTAL_. The name
# spells the setting: PORTAL_ORIGIN is the deployment's origin, and
# PORTAL_TENANT_ACME_DB_URL is the database of the tenant "acme". Names are
# uppercase with underscores; there is nothing else to spell.
#
# A tenant is declared by its variables: every PORTAL_TENANT_<ID>_… variable
# adds to the tenant <ID>, and a deployment serves every tenant so declared.
# Repeat the tenant block below once per tenant, replacing ACME with the
# tenant's id — a lowercase letter, then lowercase letters or digits, at most
# 15 characters. The id is also the first segment of every address of that
# tenant, unless the tenant is routed by host.
#
# Required settings are written out below; optional ones are commented out
# with their defaults described. Quote a value that holds a space, a # or a
# quote (in single quotes), and write a literal $ as \$ — the loader expands
# ${VAR} references in values.
#
# The same settings can be written as a JSON document instead:
# portal.config.json in the working directory, with the keys
# portal.config.schema.json describes and portal.config.example.json starts
# from. The files layer like the .env files — portal.config.<mode>.local.json,
# portal.config.local.json, portal.config.<mode>.json, portal.config.json, the
# first to hold a setting winning — and every variable, set on the process or
# read from a .env file, overrides the same setting in any of them.
#
# Where the variables go: this file, copied to .env, for pnpm dev and next
# start; the same file passed with docker run --env-file, or as env_file: in
# compose; individual variables with -e or a Kubernetes Secret. Validate a
# configuration with pnpm config:check, and write one from the variables of a
# release before with pnpm config:migrate — as portal.config.json, or as these
# variables with --format env.
#
# Generated from lib/core/config/schema.ts by pnpm config:generate. Edit the
# schema, not this file.

## Deployment ##

# Origin serving the addresses that name no tenant — "/" and the deployment's
# own routes under /deployment — e.g. https://portal.example.com, scheme and
# host only with no trailing slash. Every tenant's own origin
# (PORTAL_TENANT_<ID>_PUBLIC_HOST) is trusted for authentication alongside it,
# and a request arriving on a host none of them names is answered under this
# one. Its scheme decides whether the deployment's session cookies are written
# as __Secure-, so every origin in the configuration has to share it.
PORTAL_ORIGIN=

# Tenant serving the addresses that name none of their own: "/", and a script
# run with no --tenant. Must name a configured tenant. A deployment
# configuring one tenant leaves this out — that tenant is the only answer and
# is filled in. Beyond one it is required as soon as any tenant is reached
# under a path segment, since "/" on the origin such a tenant is served on
# names no tenant. A deployment whose tenants are all reached by host may
# leave it out; each tenant then answers "/" on the origin it holds, a script
# needs --tenant, and "/" on the deployment's own origin answers not-found
# unless a tenant holds that host too.
#PORTAL_DEFAULT_TENANT=

# Push deliveries in flight at once, and sockets held per push service. One
# agent serves the whole process, so this bounds the deployment. Defaults to
# 10. A whole number.
#PORTAL_PUSH_MAX_CONNECTIONS=

# Bytes the resized-image cache may occupy. One cache directory serves every
# tenant, so the budget is the deployment's. A whole number.
#PORTAL_IMAGE_CACHE_MAX_BYTES=

# Directory a tenant using object storage stages an upload in, under one
# subdirectory per tenant; it holds at most one part per upload in flight. A
# tenant on a filesystem stages in its own storage directory and ignores this.
# Defaults to <temp>/portal/uploads under the operating system's temporary
# directory. Point it at a volume that survives a restart to let an
# interrupted upload resume from the exact byte it reached rather than the
# last whole part.
#PORTAL_UPLOAD_TEMP_DIR=

## Tenant "acme" ##

# Signing and encryption secret for this tenant's sessions. Per tenant, not
# per deployment: each tenant authenticates through an instance of its own, so
# a secret that leaks forges sessions for that tenant alone. Generate a
# distinct long random value for every tenant (openssl rand -base64 32) — two
# tenants sharing one are refused.
PORTAL_TENANT_ACME_SESSION_SECRET=

# How this tenant's addresses are shaped. "path" (the default) carries the
# tenant id as the first path segment, e.g.
# https://portal.example.com/acme/sales, and the origin may be shared with
# other tenants. "host" drops that segment and lets
# PORTAL_TENANT_<ID>_PUBLIC_HOST name the tenant instead, e.g.
# https://acme.example.com/sales. "host" needs a host no other tenant is
# served on, and a proxy that sets X-Forwarded-Host (or Host) to the address
# the visitor used rather than the address of the server behind it — nginx
# sends its own upstream address by default, and a deployment left that way
# resolves no tenant and refuses every form submission. Changing this changes
# every address the tenant is reached at: the stored workspace URLs, the
# registered OAuth redirect URIs and the links already sent out all carry the
# old shape. One of: path, host.
#PORTAL_TENANT_ACME_ROUTING=path

# Also load the base language (e.g. 'en' for 'en-US') in addition to the
# specific locale. Defaults to false. true or false.
#PORTAL_TENANT_ACME_INCLUDE_LANGUAGE=true

# --- PORTAL_TENANT_ACME_DB_… ---

# Postgres connection URL of this tenant's own database. Every tenant has its
# own database; isolation is per-database.
PORTAL_TENANT_ACME_DB_URL=

# --- PORTAL_TENANT_ACME_AOS_… ---

# Base URL of the AOS instance, e.g. https://erp.example.com/axelor-erp.
# Unique per tenant when each tenant has a dedicated AOS instance; the same
# for every tenant sharing one multi-tenant AOS instance.
PORTAL_TENANT_ACME_AOS_URL=

# AOS-side tenant id — independent of the portal tenant id. Set it when this
# tenant lives on a shared AOS instance with AOS multi-tenancy: every AOS call
# then carries X-Tenant-ID with this value, and files are read and written
# under the subdirectory or key prefix AOP gives that tenant. Leave unset for
# a dedicated AOS instance.
#PORTAL_TENANT_ACME_AOS_TENANT_ID=

# Secret AOS uses to sign notification webhooks for this tenant. Set the same
# value in the AOS portal configuration.
#PORTAL_TENANT_ACME_AOS_WEBHOOK_SECRET=

# --- PORTAL_TENANT_ACME_AOS_STORAGE_… ---

# Where this tenant's files are kept — the same place its AOS instance keeps
# them. "filesystem" reads and writes the instance's data.upload.dir,
# configured under PORTAL_TENANT_<ID>_AOS_STORAGE_FILESYSTEM_…; "s3" reads and
# writes the bucket its data.object-storage.* settings name, configured under
# PORTAL_TENANT_<ID>_AOS_STORAGE_S3_…. One of: filesystem, s3.
PORTAL_TENANT_ACME_AOS_STORAGE_PROVIDER=filesystem

# --- PORTAL_TENANT_ACME_AOS_STORAGE_FILESYSTEM_… ---
# The AOS instance keeps its files on a filesystem the portal can reach: its
# data.upload.dir, mounted into the portal at the path given here.

# The AOS instance's data.upload.dir base path (created on first connect; back
# it with a mounted volume so uploads survive). When
# PORTAL_TENANT_<ID>_AOS_TENANT_ID is set — a tenant on a shared multi-tenant
# AOS instance — the portal reads and writes files under <dir>/<tenantId> to
# match AOP's per-tenant subdirectory; a dedicated instance uses this path
# as-is.
PORTAL_TENANT_ACME_AOS_STORAGE_FILESYSTEM_DIR=

# --- PORTAL_TENANT_ACME_AOS_STORAGE_S3_… ---
# The AOS instance keeps its files in an S3-compatible bucket, configured by
# its data.object-storage.* settings; the same values go here. When
# PORTAL_TENANT_<ID>_AOS_TENANT_ID is set — a tenant on a shared multi-tenant
# AOS instance — every key is put behind <tenantId>/ to match AOP's per-tenant
# prefix; a dedicated instance writes keys as they are.
# Optional as a whole; leave every variable out to turn it off.

# Address of the service, scheme included, e.g. https://minio.example.com:9000
# — the value of data.object-storage.endpoint with its scheme. Leave unset for
# AWS S3 itself, which the region names.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_ENDPOINT=

# Region the requests are signed for. AWS S3 requires the bucket's own; a
# service outside AWS accepts any value, and us-east-1 is used when unset.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_REGION=

# The bucket, as data.object-storage.bucket names it. It has to exist already:
# the portal does not create it, and checks it is reachable when the tenant
# connects, which needs the s3:ListBucket permission besides the object
# permissions.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_BUCKET=

# Access key of the account, set together with
# PORTAL_TENANT_<ID>_AOS_STORAGE_S3_SECRET_KEY. Leave both unset to let the
# client find credentials on its own — the AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY variables, a shared credentials file, or the role of
# the machine the portal runs on.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_ACCESS_KEY=

# Secret key going with the access key.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_SECRET_KEY=

# Address an object as <endpoint>/<bucket>/<key> rather than
# <bucket>.<endpoint>/<key> — data.object-storage.path-style. Most services
# outside AWS need true. Defaults to false. true or false.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_PATH_STYLE=true

# Server-side encryption asked for on every upload, as
# data.object-storage.encryption spells it: SSE-S3 for keys the service
# manages, SSE-KMS for a key of your own named by
# PORTAL_TENANT_<ID>_AOS_STORAGE_S3_KMS_KEY_ID. Unset leaves the bucket's own
# default in force. One of: SSE-S3, SSE-KMS.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_ENCRYPTION=SSE-S3

# The KMS key encrypting uploads — data.object-storage.encryption-kms-key-id.
# Read only with SSE-KMS.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_KMS_KEY_ID=

# Storage class every upload is written with, e.g. STANDARD or STANDARD_IA —
# data.object-storage.storage-class. Unset leaves the bucket's default.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_STORAGE_CLASS=

# Bytes every part but the last carries when a file reaches the bucket part by
# part. The S3 API takes no less than 5242880 (5 MiB) and no more than
# 5368709120 (5 GiB); defaults to 16777216 (16 MiB). Larger parts mean fewer
# requests to the bucket and more bytes held on local disk while one is
# gathered; smaller parts the reverse. A file that never fills a part is
# stored in one request once it is whole. A whole number.
#PORTAL_TENANT_ACME_AOS_STORAGE_S3_PART_SIZE=

# --- PORTAL_TENANT_ACME_AOS_AUTH_… ---
# AOS credentials: an API key (AOS 9+, generated in AOS under Preferences →
# API Keys), or a username and password for basic auth. The API key wins when
# both are set.

#PORTAL_TENANT_ACME_AOS_AUTH_API_KEY=
#PORTAL_TENANT_ACME_AOS_AUTH_USERNAME=
#PORTAL_TENANT_ACME_AOS_AUTH_PASSWORD=

# --- PORTAL_TENANT_ACME_PAYMENTS_… ---
# Per-tenant merchant accounts. A provider a tenant omits is simply
# unavailable for that tenant.
# Optional as a whole; leave every variable out to turn it off.

# --- PORTAL_TENANT_ACME_PAYMENTS_PAYPAL_… ---
# PayPal merchant account. The browser needs the client id as well, under
# PORTAL_TENANT_<ID>_PUBLIC_PAYPAL_CLIENT_ID.
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_PAYMENTS_PAYPAL_CLIENT_ID=
#PORTAL_TENANT_ACME_PAYMENTS_PAYPAL_CLIENT_SECRET=

# true for live payments; defaults to sandbox. true or false.
#PORTAL_TENANT_ACME_PAYMENTS_PAYPAL_LIVE=true

# Id of the webhook registered for this tenant in the PayPal developer
# dashboard. PayPal signs each notification, and the signature is checked
# against this id. Without it, PayPal notifications are refused and a payment
# is recorded only when the buyer comes back to the site.
#PORTAL_TENANT_ACME_PAYMENTS_PAYPAL_WEBHOOK_ID=

# --- PORTAL_TENANT_ACME_PAYMENTS_STRIPE_… ---
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_PAYMENTS_STRIPE_CLIENT_SECRET=

# Two-letter country whose bank account Stripe presents for EUR bank
# transfers; defaults to FR.
#PORTAL_TENANT_ACME_PAYMENTS_STRIPE_BANK_TRANSFER_COUNTRY=

# Stripe webhook signing secret for this tenant's webhook endpoint. Without
# it, bank transfer is not offered at checkout.
#PORTAL_TENANT_ACME_PAYMENTS_STRIPE_WEBHOOK_SECRET=

# --- PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_… ---
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_SITE=
#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_RANG=
#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_IDENTIFIANT=
#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_SECRET=

# Paybox payment page base URL.
#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_PAYBOX=

#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_BACKUP1=
#PORTAL_TENANT_ACME_PAYMENTS_PAYBOX_BACKUP2=

# --- PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_… ---
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_SITE=
#PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_RANG=
#PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_IDENTIFIANT=
#PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_SECRET=

# Up2Pay payment page base URL.
#PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_PAYBOX=

# Where to forward Up2Pay IPNs this tenant cannot attribute to a portal
# payment (legacy-ERP invoices, unknown context). Omit to not forward.
#PORTAL_TENANT_ACME_PAYMENTS_UP2PAY_LEGACY_FORWARD_URL=

# --- PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_… ---
# Hub PISP (BPCE) account. Register this tenant's webhook under this tenant's
# own path — /<tenantId>/api/webhooks/hubpisp/..., without the <tenantId>
# segment for a tenant reached on an origin of its own — so the webhook uses
# this tenant's credentials.
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_TOKEN_URL=
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_API_URL=
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_CLIENT_ID=
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_CLIENT_SECRET=
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_CERT_FINGERPRINT=

# Name of the account a payment is credited to, at most 70 characters — the
# ISO 20022 limit for a creditor name. The value is sent as it stands, with
# nothing truncating it on the way out.
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_BENEFICIARY_NAME=

#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_IBAN=
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_BIC=

# Directory holding this tenant's mTLS client.crt and private-key.pem. Must be
# distinct per Hub PISP tenant — the certificate is the tenant's bank
# identity, so there is no shared default.
#PORTAL_TENANT_ACME_PAYMENTS_HUBPISP_CERTS_DIR=

# --- PORTAL_TENANT_ACME_MAIL_… ---
# Per-tenant SMTP settings.
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_MAIL_HOST=

# TCP port the SMTP server listens on, commonly 587 for STARTTLS or 465 with
# secure set. A whole number.
#PORTAL_TENANT_ACME_MAIL_PORT=

# true or false.
#PORTAL_TENANT_ACME_MAIL_SECURE=true

#PORTAL_TENANT_ACME_MAIL_USER=
#PORTAL_TENANT_ACME_MAIL_PASSWORD=

# From address; defaults to user.
#PORTAL_TENANT_ACME_MAIL_EMAIL=

# Connections this tenant's mail account may hold open at once. A mail server
# limits concurrency per sender, so the ceiling belongs to the account — a
# Microsoft 365 mailbox allows three. Tenants sharing a mailbox share one pool
# and one ceiling, so they must agree on this value or the configuration is
# refused at startup. Defaults to 10. A whole number.
#PORTAL_TENANT_ACME_MAIL_MAX_CONNECTIONS=

# --- PORTAL_TENANT_ACME_MATTERMOST_… ---
# Mattermost integration. The address the browser links to is browser-facing
# and lives under PORTAL_TENANT_<ID>_PUBLIC_MATTERMOST_HOST.
# Optional as a whole; leave every variable out to turn it off.

# Mattermost admin token.
#PORTAL_TENANT_ACME_MATTERMOST_TOKEN=

# Create Mattermost users on registration. true or false.
#PORTAL_TENANT_ACME_MATTERMOST_CREATE_USERS=true

# --- PORTAL_TENANT_ACME_OAUTH_… ---
# Per-tenant OAuth applications. Each provider is registered under the
# provider id '<provider>-<tenantId>' — register the matching redirect URI
# (/<tenantId>/api/auth/oauth2/callback/<provider>-<tenantId>, without the
# <tenantId> segment for a tenant reached on an origin of its own) with the
# identity provider. There is no global app: a tenant offers a provider only
# when it declares it here.
# Optional as a whole; leave every variable out to turn it off.

# --- PORTAL_TENANT_ACME_OAUTH_GOOGLE_… ---
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_OAUTH_GOOGLE_CLIENT_ID=
#PORTAL_TENANT_ACME_OAUTH_GOOGLE_CLIENT_SECRET=

# --- PORTAL_TENANT_ACME_OAUTH_KEYCLOAK_… ---
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_OAUTH_KEYCLOAK_CLIENT_ID=
#PORTAL_TENANT_ACME_OAUTH_KEYCLOAK_CLIENT_SECRET=

# Keycloak realm issuer URL, with or without a trailing slash. Each tenant
# uses its own realm.
#PORTAL_TENANT_ACME_OAUTH_KEYCLOAK_ISSUER=

# --- PORTAL_TENANT_ACME_WEB_PUSH_… ---
# Web-push signing identity; the public key lives under
# PORTAL_TENANT_<ID>_PUBLIC_WEB_PUSH_PUBLIC_KEY. The service worker registers
# once per tenant — under the tenant path segment where several tenants share
# an origin, and at the root of the origin where the tenant has one to itself
# — so each tenant holds its own push subscription and its own key pair takes
# effect either way.
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_WEB_PUSH_PRIVATE_KEY=

# mailto: address or https: URL identifying the sender to push services.
#PORTAL_TENANT_ACME_WEB_PUSH_SUBJECT=

# --- PORTAL_TENANT_ACME_UPLOAD_… ---
# Optional as a whole; leave every variable out to turn it off.

# How long terminal staged-upload records are kept before the prune sweep
# deletes them. Defaults to 168 (7 days). A number.
#PORTAL_TENANT_ACME_UPLOAD_RECORD_RETENTION_HOURS=

# --- PORTAL_TENANT_ACME_PUBLIC_… ---
# Browser-facing settings for this tenant. Everything in this group is sent to
# every visitor; nothing outside it is.

# Origin this tenant is served on, e.g. https://portal.example.com — scheme
# and host only, with no trailing slash. Workspace URLs are stored against it,
# every absolute link is built from it, and the deployment trusts it as an
# origin to authenticate on, so a tenant without one resolves no workspace.
# Tenants sharing an origin is the ordinary case; the scheme must be the one
# PORTAL_ORIGIN carries.
PORTAL_TENANT_ACME_PUBLIC_HOST=

# --- PORTAL_TENANT_ACME_PUBLIC_PAYPAL_… ---
# Optional as a whole; leave every variable out to turn it off.

# The PayPal client id the browser's checkout button is created with. Public
# by design; the secret stays in the payments group.
#PORTAL_TENANT_ACME_PUBLIC_PAYPAL_CLIENT_ID=

# --- PORTAL_TENANT_ACME_PUBLIC_WEB_PUSH_… ---
# Optional as a whole; leave every variable out to turn it off.

# The VAPID public key a browser subscribes with. Pairs with
# PORTAL_TENANT_<ID>_WEB_PUSH_PRIVATE_KEY; both are needed for notifications.
#PORTAL_TENANT_ACME_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# --- PORTAL_TENANT_ACME_PUBLIC_MATTERMOST_… ---
# Optional as a whole; leave every variable out to turn it off.

# Mattermost address the sidebar links to.
#PORTAL_TENANT_ACME_PUBLIC_MATTERMOST_HOST=

# --- PORTAL_TENANT_ACME_PUBLIC_KEYCLOAK_… ---
# Optional as a whole; leave every variable out to turn it off.

# Text of the Keycloak sign-in button; defaults to "Log In with Keycloak".
#PORTAL_TENANT_ACME_PUBLIC_KEYCLOAK_BUTTON_LABEL=

# Address of the image shown on the Keycloak sign-in button; defaults to the
# bundled Keycloak mark.
#PORTAL_TENANT_ACME_PUBLIC_KEYCLOAK_BUTTON_IMAGE=

# --- PORTAL_TENANT_ACME_PUBLIC_LINKS_… ---
# Social addresses the news application offers to share to.
# Optional as a whole; leave every variable out to turn it off.

#PORTAL_TENANT_ACME_PUBLIC_LINKS_LINKEDIN=
#PORTAL_TENANT_ACME_PUBLIC_LINKS_TWITTER=
#PORTAL_TENANT_ACME_PUBLIC_LINKS_INSTAGRAM=
#PORTAL_TENANT_ACME_PUBLIC_LINKS_WHATSAPP=

## Build-time ##

# The one browser variable read from the environment rather than the
# configuration: it is inlined into the client bundle at build time, so
# changing it means rebuilding the app, and no portal.config file can carry
# it. Empty for a root deployment, or a subpath like /portal.
#NEXT_PUBLIC_BASE_PATH=
