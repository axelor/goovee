{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/subapps/*": ["./app/[tenant]/[workspace]/(subapps)/*"],
      "@/access/*": ["./lib/core/access/*"],
      "@/auth": ["./lib/core/auth/index"],
      "@/auth/*": ["./lib/core/auth/*"],
      "@/cache/*": ["./lib/core/cache/*"],
      "@/comments": ["./lib/core/comments/index"],
      "@/comments/*": ["./lib/core/comments/*"],
      "@/concurrency/*": ["./lib/core/concurrency/*"],
      "@/config/*": ["./lib/core/config/*"],
      "@/environment": ["./lib/core/environment/index"],
      "@/environment/*": ["./lib/core/environment/*"],
      "@/image": ["./lib/core/image/index"],
      "@/image/*": ["./lib/core/image/*"],
      "@/locale": ["./lib/core/locale/index"],
      "@/locale/*": ["./lib/core/locale/*"],
      "@/mattermost": ["./lib/core/mattermost/index"],
      "@/mattermost/*": ["./lib/core/mattermost/*"],
      "@/notification": ["./lib/core/notification/index"],
      "@/notification/*": ["./lib/core/notification/*"],
      "@/otp": ["./lib/core/otp/index"],
      "@/otp/*": ["./lib/core/otp/*"],
      "@/path/*": ["./lib/core/path/*"],
      "@/payment/*": ["./lib/core/payment/*"],
      "@/product/*": ["./lib/core/product/*"],
      "@/pwa/*": ["./lib/core/pwa/*"],
      "@/runtime/*": ["./lib/core/runtime/*"],
      "@/security/*": ["./lib/core/security/*"],
      "@/service": ["./lib/core/service/index"],
      "@/service/*": ["./lib/core/service/*"],
      "@/storage/*": ["./lib/core/storage/*"],
      "@/tenant": ["./lib/core/tenant/index"],
      "@/tenant/*": ["./lib/core/tenant/*"],
      "@/upload/*": ["./lib/core/upload/*"],
      "@/url": ["./lib/core/url/index"],
      "@/url/*": ["./lib/core/url/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
